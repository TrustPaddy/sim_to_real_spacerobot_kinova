<?xml version="1.0"?>
<!-- REFERENZ-TEMPLATE: Nutze make_spacekinova_urdf.m zur URDF-Generierung -->
<robot name="space_kinova_template">

  <!-- central cube base (65 kg, 1x1x1 m) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="65.0"/>
      <!-- I = (1/12)*M*(a^2+b^2) = (1/12)*65*2 = 10.833 -->
      <inertia ixx="10.833" iyy="10.833" izz="10.833" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.0 1.0 1.0"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>

  <!-- fixed mount to your Kinova base (replace kinova_base_link with the prefixed root link) -->
  <joint name="base_to_kinova" type="fixed">
    <parent link="base_link"/>
    <child link="kinova_base_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- paste your Kinova URDF content here (with all names prefixed to avoid collisions) -->

</robot>
